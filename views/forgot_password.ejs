<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ลืมรหัสผ่าน - ระบบทุนการศึกษา</title>

<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
:root {
    --swu-red: #dd1f28;
    --swu-red-hover: #b41720;
    --bg-gray: #f0f2f5;
    --text-dark: #333333;
}

body {
  background-color: var(--bg-gray);
  font-family: 'Prompt', sans-serif;
  color: var(--text-dark);
  padding-bottom: 20px; 
}

.logo {
  width: 300px;
  display: block;
  margin: 30px auto 10px;
}
.title-text {
  text-align: center;
  font-size: 24px;
  font-weight: 400;
  margin-top: 5px;
  margin-bottom: 30px;
  color: var(--text-dark);
}

/* --- Card Layout --- */
.forgot-card {
  background: white;
  border-radius: 16px;
  width: 100%;
  max-width: 450px;
  margin: 0 auto 40px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  padding: 40px;
  position: relative;
  overflow: hidden;
}

/* Input Fields */
.form-control {
    padding: 12px 15px;
    border-radius: 8px;
    border-color: #e0e0e0;
    font-size: 14px;
}
.form-control:focus {
    border-color: var(--swu-red);
    box-shadow: 0 0 0 0.2rem rgba(221, 31, 40, 0.15);
}
.form-label {
    font-weight: 600;
    font-size: 14px;
    color: #555;
    margin-bottom: 6px;
}
.input-group-text {
    border-radius: 8px 0 0 8px;
    border-color: #e0e0e0;
}
.input-group .form-control {
    border-radius: 0 8px 8px 0;
}

/* Button */
.btn-submit {
  background-color: var(--swu-red);
  border: none;
  padding: 12px;
  font-weight: 600;
  transition: all 0.3s ease;
  border-radius: 8px;
  color: white;
  width: 100%;
}
.btn-submit:hover {
  background-color: var(--swu-red-hover);
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(221, 31, 40, 0.3);
}
.btn-submit:disabled {
    background-color: #ccc;
    transform: none;
    box-shadow: none;
}

.back-link {
    color: #666;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
}
.back-link:hover {
    color: var(--swu-red);
}

/* Footer */
.footer {
  text-align: center;
  margin-top: 20px;
  padding: 20px;
  color: #888;
  font-size: 12px;
}

/* Utility */
.letter-spacing-2 {
    letter-spacing: 5px;
    font-size: 20px;
    font-weight: 600;
}
</style>
</head>
<body>

<div class="container">
    <img src="/images/swu_logo.png" class="logo" alt="SWU Logo" onerror="this.onerror=null; this.src='https://upload.wikimedia.org/wikipedia/commons/thumb/6/6f/Srinakharinwirot_University_Logo.png/600px-Srinakharinwirot_University_Logo.png'" />

    <div class="title-text">ระบบกู้คืนรหัสผ่าน</div>

    <div class="forgot-card">
        
        <div id="step1">
            <div class="text-center mb-4">
                <i class="fa-solid fa-lock text-secondary fa-3x mb-3"></i>
                <h4 class="fw-bold">ระบุบัญชีผู้ใช้</h4>
                <p class="text-muted small">กรุณากรอกอีเมลที่ท่านลงทะเบียนไว้<br>เพื่อรับรหัสยืนยันตัวตน (OTP)</p>
            </div>

            <form onsubmit="sendOTP(event)">
                <div class="mb-4">
                    <label class="form-label">อีเมล (Email)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-envelope"></i></span>
                        <input type="email" id="emailInput" class="form-control" placeholder="name@example.com" required>
                    </div>
                </div>
                
                <button type="submit" id="btn1" class="btn btn-submit mb-3">
                    <i class="fa-solid fa-paper-plane me-2"></i>ส่งรหัส OTP
                </button>
            </form>
        </div>

        <div id="step2" style="display: none;">
            <div class="text-center mb-4">
                <i class="fa-solid fa-shield-halved text-primary fa-3x mb-3"></i>
                <h4 class="fw-bold">ยืนยันรหัส OTP</h4>
                <p class="text-muted small">รหัสถูกส่งไปยัง <span id="showEmail" class="fw-bold text-dark"></span><br>กรุณาตรวจสอบกล่องจดหมายของท่าน</p>
            </div>

            <form onsubmit="verifyOTP(event)">
                <div class="mb-4">
                    <label class="form-label text-center w-100">รหัส OTP 6 หลัก</label>
                    <input type="text" id="otpInput" class="form-control text-center letter-spacing-2" placeholder="XXXXXX" maxlength="6" required autocomplete="off">
                </div>
                
                <button type="submit" id="btn2" class="btn btn-submit mb-3">
                    <i class="fa-solid fa-check-circle me-2"></i>ตรวจสอบรหัส OTP
                </button>
            </form>
        </div>

        <div id="step3" style="display: none;">
            <div class="text-center mb-4">
                <i class="fa-solid fa-key text-success fa-3x mb-3"></i>
                <h4 class="fw-bold">ตั้งรหัสผ่านใหม่</h4>
                <p class="text-success small"><i class="fa-solid fa-circle-check me-1"></i>ยืนยันตัวตนสำเร็จ</p>
            </div>

            <form onsubmit="resetPassword(event)">
                <div class="mb-3">
                    <label class="form-label">รหัสผ่านใหม่</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" id="newPassword" class="form-control" placeholder="รหัสผ่านอย่างน้อย 6 ตัวอักษร" minlength="6" required>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label">ยืนยันรหัสผ่านใหม่</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" id="confirmNewPassword" class="form-control" placeholder="กรอกรหัสผ่านใหม่อีกครั้ง" minlength="6" required>
                    </div>
                </div>
                
                <button type="submit" id="btn3" class="btn btn-submit mb-3">
                    <i class="fa-solid fa-save me-2"></i>บันทึกรหัสผ่าน
                </button>
            </form>
        </div>

        <div class="text-center mt-2">
            <a href="/login" class="back-link">
                <i class="fa-solid fa-arrow-left me-1"></i> กลับไปหน้าเข้าสู่ระบบ
            </a>
        </div>
    </div>

    <div class="footer">
    Copyright © Srinakharinwirot University<br>
    114 Sukhumvit 23, Bangkok 10110, Thailand.
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    let userEmail = "";

    // Helper function สำหรับแสดง Loading ที่ปุ่ม
    function setLoading(btnId, isLoading, text) {
        const btn = document.getElementById(btnId);
        if (isLoading) {
            btn.dataset.originalText = btn.innerHTML;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin me-2"></i>กำลังประมวลผล...`;
            btn.disabled = true;
        } else {
            btn.innerHTML = btn.dataset.originalText || text;
            btn.disabled = false;
        }
    }

    // 1. ส่ง OTP
    async function sendOTP(e) {
        e.preventDefault();
        userEmail = document.getElementById('emailInput').value;
        setLoading('btn1', true);

        try {
            const res = await fetch('/api/forgot/send-otp', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ email: userEmail })
            });
            const data = await res.json();

            if(data.success) {
                document.getElementById('step1').style.display = 'none';
                document.getElementById('step2').style.display = 'block';
                document.getElementById('showEmail').innerText = userEmail;
                Swal.fire('สำเร็จ!', 'ส่งรหัส OTP ไปยังอีเมลของท่านแล้ว กรุณาตรวจสอบ (รวมถึงใน Junk/Spam)', 'success');
            } else {
                Swal.fire('แจ้งเตือน', data.message, 'error');
                setLoading('btn1', false);
            }
        } catch (error) {
            Swal.fire('ข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้', 'error');
            setLoading('btn1', false);
        }
    }

    // 2. ตรวจสอบ OTP
    async function verifyOTP(e) {
        e.preventDefault();
        const otp = document.getElementById('otpInput').value;
        setLoading('btn2', true);

        try {
            const res = await fetch('/api/forgot/verify-otp', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ email: userEmail, otp: otp })
            });
            const data = await res.json();

            if(data.success) {
                document.getElementById('step2').style.display = 'none';
                document.getElementById('step3').style.display = 'block';
                Swal.fire('ยืนยันสำเร็จ!', 'รหัส OTP ถูกต้อง กรุณาตั้งรหัสผ่านใหม่', 'success');
            } else {
                Swal.fire('แจ้งเตือน', data.message, 'error');
                setLoading('btn2', false);
            }
        } catch (error) {
            Swal.fire('ข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้', 'error');
            setLoading('btn2', false);
        }
    }

    // 3. เปลี่ยนรหัสผ่าน
    async function resetPassword(e) {
        e.preventDefault();
        const otp = document.getElementById('otpInput').value;
        const p1 = document.getElementById('newPassword').value;
        const p2 = document.getElementById('confirmNewPassword').value;

        if(p1 !== p2) return Swal.fire('แจ้งเตือน', 'รหัสผ่านใหม่ทั้งสองช่องไม่ตรงกัน', 'warning');
        
        setLoading('btn3', true);

        try {
            const res = await fetch('/api/forgot/reset-password', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ email: userEmail, otp: otp, newPassword: p1 })
            });
            const data = await res.json();

            if(data.success) {
                await Swal.fire('เรียบร้อย!', 'เปลี่ยนรหัสผ่านสำเร็จแล้ว กรุณาเข้าสู่ระบบด้วยรหัสผ่านใหม่', 'success');
                window.location.href = '/login';
            } else {
                Swal.fire('แจ้งเตือน', data.message, 'error');
                setLoading('btn3', false);
            }
        } catch (error) {
            Swal.fire('ข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้', 'error');
            setLoading('btn3', false);
        }
    }
</script>
</body>
</html>