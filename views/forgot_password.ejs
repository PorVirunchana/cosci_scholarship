<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ลืมรหัสผ่าน - ระบบทุนการศึกษา</title>

<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
:root {
    --swu-red: #dd1f28;
    --swu-red-hover: #b41720;
    --bg-gray: #f0f2f5;
    --text-dark: #333333;
}

body {
  background-color: var(--bg-gray);
  font-family: 'Prompt', sans-serif;
  color: var(--text-dark);
  padding-bottom: 20px; 
}

.logo {
  width: 300px;
  display: block;
  margin: 30px auto 10px;
}
.title-text {
  text-align: center;
  font-size: 24px;
  font-weight: 400;
  margin-top: 5px;
  margin-bottom: 30px;
  color: var(--text-dark);
}

/* --- Card Layout --- */
.forgot-card {
  background: white;
  border-radius: 16px;
  width: 100%;
  max-width: 450px;
  margin: 0 auto 40px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  padding: 40px;
  position: relative;
  overflow: hidden;
}

/* Input Fields */
.form-control {
    padding: 12px 15px;
    border-radius: 8px;
    border-color: #e0e0e0;
    font-size: 14px;
}
.form-control:focus {
    border-color: var(--swu-red);
    box-shadow: 0 0 0 0.2rem rgba(221, 31, 40, 0.15);
}
.form-label {
    font-weight: 600;
    font-size: 14px;
    color: #555;
    margin-bottom: 6px;
}

/* Button */
.btn-submit {
  background-color: var(--swu-red);
  border: none;
  padding: 12px;
  font-weight: 600;
  transition: all 0.3s ease;
  border-radius: 8px;
  color: white;
  width: 100%;
}
.btn-submit:hover {
  background-color: var(--swu-red-hover);
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(221, 31, 40, 0.3);
}

.back-link {
    color: #666;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
}
.back-link:hover {
    color: var(--swu-red);
}

/* Footer */
.footer {
  text-align: center;
  margin-top: 20px;
  padding: 20px;
  color: #888;
  font-size: 12px;
}
</style>
</head>
<body>

<div class="container">
    <img src="/images/swu_logo.png" class="logo" alt="SWU Logo" onerror="this.onerror=null; this.src='https://upload.wikimedia.org/wikipedia/commons/thumb/6/6f/Srinakharinwirot_University_Logo.png/600px-Srinakharinwirot_University_Logo.png'" />

    <div class="title-text">ลืมรหัสผ่าน</div>

    <div class="forgot-card">
        
        <!-- Step 1: กรอกอีเมล -->
        <div id="step1">
            <div class="text-center mb-4">
                <i class="fa-solid fa-lock text-secondary fa-3x mb-3"></i>
                <h4 class="fw-bold">กู้คืนบัญชีผู้ใช้</h4>
                <p class="text-muted small">กรุณากรอกอีเมลที่ท่านลงทะเบียนไว้<br>ระบบจะส่งรหัส OTP เพื่อยืนยันตัวตน</p>
            </div>

            <form onsubmit="handleSendOTP(event)">
                <div class="mb-4">
                    <label class="form-label">อีเมล (Email)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                        <input type="email" id="emailInput" class="form-control border-start-0 ps-0" placeholder="name@example.com" required>
                    </div>
                </div>
                
                <button type="submit" class="btn btn-submit mb-3">ส่งรหัสยืนยัน (OTP)</button>
            </form>
        </div>

        <!-- Step 2: กรอก OTP และรหัสผ่านใหม่ (ซ่อนไว้ก่อน) -->
        <div id="step2" style="display: none;">
            <div class="text-center mb-4">
                <i class="fa-solid fa-shield-halved text-success fa-3x mb-3"></i>
                <h4 class="fw-bold">ยืนยันรหัส OTP</h4>
                <p class="text-muted small">รหัส OTP ถูกส่งไปยัง <span id="userEmailDisplay" class="fw-bold text-dark"></span></p>
            </div>

            <form onsubmit="handleResetPassword(event)">
                <div class="mb-3">
                    <label class="form-label">รหัส OTP (4 หลัก)</label>
                    <input type="text" class="form-control text-center letter-spacing-2" placeholder="XXXX" maxlength="4" required style="letter-spacing: 5px; font-size: 18px;">
                </div>

                <hr class="my-4">

                <div class="mb-3">
                    <label class="form-label">รหัสผ่านใหม่</label>
                    <input type="password" id="newPassword" class="form-control" placeholder="รหัสผ่านใหม่" required>
                </div>
                <div class="mb-4">
                    <label class="form-label">ยืนยันรหัสผ่านใหม่</label>
                    <input type="password" id="confirmNewPassword" class="form-control" placeholder="ยืนยันรหัสผ่าน" required>
                </div>
                
                <button type="submit" class="btn btn-submit mb-3">เปลี่ยนรหัสผ่าน</button>
            </form>
        </div>

        <div class="text-center mt-2">
            <a href="/login" class="back-link"><i class="fa-solid fa-arrow-left me-1"></i> กลับไปหน้าเข้าสู่ระบบ</a>
        </div>
    </div>

    <div class="footer">
    Copyright © Srinakharinwirot University<br>
    114 Sukhumvit 23, Bangkok 10110, Thailand. E-mail : contact@g.swu.ac.th
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ฟังก์ชันจำลองการส่ง OTP
    function handleSendOTP(event) {
        event.preventDefault();
        const email = document.getElementById('emailInput').value;
        
        // จำลอง Loading
        const btn = event.target.querySelector('button');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> กำลังส่ง...';
        btn.disabled = true;

        setTimeout(() => {
            // ซ่อน Step 1 แสดง Step 2
            document.getElementById('step1').style.display = 'none';
            document.getElementById('step2').style.display = 'block';
            document.getElementById('userEmailDisplay').innerText = email;
            
            alert('รหัส OTP คือ: 1234 (จำลอง)'); // บอกรหัสสำหรับการทดสอบ
        }, 1500);
    }

    // ฟังก์ชันจำลองการเปลี่ยนรหัสผ่าน
    function handleResetPassword(event) {
        event.preventDefault();
        
        const p1 = document.getElementById('newPassword').value;
        const p2 = document.getElementById('confirmNewPassword').value;

        if(p1 !== p2) {
            alert('รหัสผ่านใหม่ไม่ตรงกัน');
            return;
        }

        alert('เปลี่ยนรหัสผ่านสำเร็จ! กรุณาเข้าสู่ระบบด้วยรหัสผ่านใหม่');
        window.location.href = 'index.html';
    }
</script>
</body>
</html>