<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ลงทะเบียนนิสิตใหม่</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    </head>
<body style="background-color: #f5f5f5;">

<div class="container py-5">
    <div class="register-card bg-white p-4 rounded shadow-sm">
        <div class="col-12">
            <div class="form-container">
                <h4 class="mb-4 fw-bold" style="color:var(--text-dark); border-left: 5px solid #d9534f; padding-left: 10px;">กรอกข้อมูลส่วนตัว</h4>

                <form id="registerForm" onsubmit="handleRegister(event)">
                    
                    <h6 class="text-muted border-bottom pb-2 mb-3">ข้อมูลบัญชีผู้ใช้</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">รหัสนิสิต (Student ID) <span class="text-danger">*</span></label>
                            <input type="text" id="stu_id" class="form-control" placeholder="เช่น 6610xxxxx" required maxlength="11">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">รหัสบัวศรี (Buasri ID) <span class="text-danger">*</span></label>
                            <input type="text" id="stu_buasri" class="form-control" placeholder="กรุณากรอกรหัสบัวศรี" required maxlength="11">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">ชื่อ-นามสกุล (TH) <span class="text-danger">*</span></label>
                        <input type="text" id="stu_name" class="form-control" placeholder="นาย..." required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">ชื่อ-นามสกุล (EN) <span class="text-danger">*</span></label>
                        <input type="text" id="stu_eng_name" class="form-control" placeholder="Mr..." required>
                    </div>

                    <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">ข้อมูลการศึกษา</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">สาขาวิชา (Major) <span class="text-danger">*</span></label>
                            
                            <select id="stu_major" class="form-select" required>
                                <option value="" selected disabled>-- กรุณาเลือกสาขาวิชา --</option>
                                <% if(majors && majors.length > 0) { %>
                                    <% majors.forEach(function(m) { %>
                                        <option value="<%= m.maj_id %>"><%= m.maj_th_name %></option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="">ไม่พบข้อมูลสาขา</option>
                                <% } %>
                            </select>

                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">กลุ่มผู้เรียน (Group)<span class="text-danger">*</span></label>
                            <input type="text" id="stu_group" class="form-control" placeholder="ระบุหมู่เรียน ICxxx" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">อาจารย์ที่ปรึกษา (Advisor) <span class="text-danger">*</span></label>
                        <select id="stu_advisor" class="form-select" required>
                            <option value="" selected disabled>-- กรุณาเลือกอาจารย์ที่ปรึกษา --</option>
                            <% if(staffs && staffs.length > 0) { %>
                                <% staffs.forEach(function(s) { %>
                                    <option value="<%= s.staff_id %>"><%= s.staff_name %></option>
                                <% }); %>
                            <% } else { %>
                                <option value="">ไม่พบรายชื่ออาจารย์</option>
                            <% } %>
                        </select>
                    </div>

                    <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">ตั้งค่ารหัสผ่าน</h6>
                    <div class="mb-3">
                        <label class="form-label">อีเมล (Email) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                            <input type="email" id="stu_email" class="form-control" placeholder="name@gmail.com" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">รหัสผ่าน (Password) <span class="text-danger">*</span></label>
                            <input type="password" id="stu_pass" class="form-control" placeholder="ตั้งรหัสผ่าน" required minlength="6">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ยืนยันรหัสผ่าน (Re-Password) <span class="text-danger">*</span></label>
                            <input type="password" id="stu_repass" class="form-control" placeholder="กรอกรหัสผ่านอีกครั้ง" required>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="agree" required>
                        <label class="form-check-label small text-muted" for="agree">
                            ข้าพเจ้ายอมรับข้อตกลงและเงื่อนไขการใช้งาน
                        </label>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-danger w-100 text-white shadow-sm">ลงทะเบียน</button>

                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="text-muted small">มีบัญชีผู้ใช้งานอยู่แล้ว?</span>
                        <a href="/login" class="fw-bold text-decoration-underline ms-1" style="color: #d9534f;">เข้าสู่ระบบที่นี่</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    async function handleRegister(event) {
        event.preventDefault();
        
        const stu_id = document.getElementById('stu_id').value;
        const stu_buasri = document.getElementById('stu_buasri').value;
        const stu_name = document.getElementById('stu_name').value;
        const stu_eng_name = document.getElementById('stu_eng_name').value;
        
        // รับค่า value จาก Dropdown (จะเป็น ID เช่น 001 หรือ ST001)
        const stu_major = document.getElementById('stu_major').value;
        const stu_advisor = document.getElementById('stu_advisor').value;
        
        const stu_group = document.getElementById('stu_group').value;
        const stu_email = document.getElementById('stu_email').value;
        const stu_pass = document.getElementById('stu_pass').value;
        const stu_repass = document.getElementById('stu_repass').value;

        if (stu_pass !== stu_repass) {
            alert('❌ รหัสผ่านและการยืนยันรหัสผ่านไม่ตรงกัน');
            document.getElementById('stu_repass').value = ''; 
            return; 
        }
        
        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.innerText = 'กำลังบันทึก...';

        try {
            const response = await fetch('/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    stu_id, stu_buasri, stu_name, stu_eng_name, stu_email, stu_group, 
                    stu_major,   // ID ของสาขา
                    stu_advisor, // ID ของอาจารย์
                    stu_pass
                })
            });

            const result = await response.json();

            if (result.success) {
                alert('✅ ลงทะเบียนสำเร็จ!');
                window.location.href = '/login';
            } else {
                alert('❌ ลงทะเบียนไม่สำเร็จ: ' + result.message);
                submitBtn.disabled = false;
                submitBtn.innerText = 'ลงทะเบียน';
            }

        } catch (error) {
            console.error('Error:', error);
            alert('❌ เกิดข้อผิดพลาดในการเชื่อมต่อ');
            submitBtn.disabled = false;
            submitBtn.innerText = 'ลงทะเบียน';
        }
    }
</script>
</body>
</html>